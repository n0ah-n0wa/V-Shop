# Telegram Bot
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# PostgreSQL connection string (async driver).
# NOTE: when running under Docker Compose this value is IGNORED — compose sets
# DATABASE_URL to the internal `db:5432` address, which outranks this file.
# Set it only for non-Docker runs (local venv, systemd), e.g.:
#   DATABASE_URL=postgresql+asyncpg://vshop:vshop@localhost:5432/vshop
# The value actually in use is logged at startup.
DATABASE_URL=postgresql+asyncpg://vshop:vshop@db:5433/vshop
POSTGRES_PORT=5433

# REQUIRED — the Docker volume holding the PostgreSQL data directory. Compose
# never creates it (the volume is `external`), so an unset or wrong name stops
# the deploy instead of starting the bot on a new, empty database.
#   New deployment:      run `docker volume create vshop_pgdata`, then set
#                        POSTGRES_VOLUME_NAME=vshop_pgdata
#   Existing deployment: run `docker volume ls` and set this to the volume that
#                        already holds your data (e.g. v-shop_pgdata).
# See docs/deployment.md.
# POSTGRES_VOLUME_NAME=vshop_pgdata

# --- PostgreSQL (Docker Compose only) ---------------------------------------
# Compose falls back to these defaults when unset. `vshop` is fine for local
# development and is NOT acceptable in production: set POSTGRES_PASSWORD.
# POSTGRES_DB=vshop
# POSTGRES_USER=vshop
# POSTGRES_PASSWORD=vshop
# Host port Postgres is published on, bound to 127.0.0.1 only. Change this if
# something already owns 5432 (a native PostgreSQL service usually does).
# The port INSIDE the container is always 5432 — editing DATABASE_URL above
# does not move the published port, and under Docker that line is ignored.
# POSTGRES_PORT=5432
#
# POSTGRES_PASSWORD takes effect only when the database volume is created.
# Changing it later needs ALTER USER as well — see docs/deployment.md.

# Comma-separated Telegram user IDs with admin access
# (also receive new-order notifications in private chat)
ADMIN_IDS=123456789,987654321

# Manager group OR private admin chat for new order notifications
MANAGER_CHAT_ID=-1001234567890

# Private customer reviews group (optional).
# The bot must be an ADMIN there with can_invite_users so it can create
# invite links. Customers only ever receive the link, never this ID.
# REVIEW_GROUP_CHAT_ID=-1001234567890
# Optional: use a fixed invite link instead of generating one.
# REVIEW_INVITE_LINK=https://t.me/+AbCdEf123456

# Application
# IANA time zone for statistics month boundaries (not the server clock).
APP_TIMEZONE=Europe/Berlin
CURRENCY_SYMBOL=€
# production for a deployment. development / dev / local echo every SQL
# statement to the log (never its values) — for a developer machine only.
APP_ENV=production
LOG_LEVEL=INFO

# Set to false only if your network intercepts TLS (corporate proxy)
TELEGRAM_SSL_VERIFY=true

# Loyalty stamp card (optional; these are the defaults)
# LOYALTY_STAMP_PURCHASE_THRESHOLD=20.00
# LOYALTY_STAMPS_REQUIRED=10
# LOYALTY_FREE_BOTTLE_MAX_PRICE=20.00

# Roulette spins (optional; these are the defaults)
# ROULETTE_INITIAL_FREE_SPIN=true
# ROULETTE_SPIN_EVERY_N_PURCHASES=5
# REFERRAL_SPINS=1

# Referral bonuses (optional; these are the defaults; 0 = none for that side)
# REFERRAL_REWARD_STAMPS=2
# REFERRED_USER_START_STAMPS=2

# Roulette prize weights (optional; chance = weight / sum of all weights; 0 = off)
# ROULETTE_PRIZE_STAMP_1_WEIGHT=40
# ROULETTE_PRIZE_STAMP_2_WEIGHT=25
# ROULETTE_PRIZE_DISCOUNT_5_WEIGHT=20
# ROULETTE_PRIZE_DISCOUNT_10_WEIGHT=10
# ROULETTE_PRIZE_FREE_BOTTLE_WEIGHT=5
